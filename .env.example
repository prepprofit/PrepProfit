# ──────────────────────────────────────────────────────────────
# PrepProfit — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit secrets.
# See SETUP.md for step-by-step instructions to obtain these.
# ──────────────────────────────────────────────────────────────

# Neon Postgres — connection string (use the POOLED connection string)
# Get it from: Neon dashboard → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Clerk — auth + Organizations
# Get these from: Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# Clerk — routing (defaults match the app's route structure)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Clerk — billing/org-lifecycle webhook (Sprint 4c). REQUIRED in production:
# verifies the Svix signature on /api/webhooks/clerk; without it every Clerk
# event (subscription mirror, org lifecycle, billing emails) is rejected.
# Get it from: Clerk dashboard → Webhooks → your endpoint → Signing Secret.
CLERK_WEBHOOK_SIGNING_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"

# Cron — shared secret protecting the trash auto-purge route
# (/api/cron/purge-trash). Vercel sends it automatically as a Bearer token to
# scheduled invocations once set in the project's Environment Variables.
# Generate a long random value, e.g.: openssl rand -hex 32
CRON_SECRET="generate-a-long-random-string"

# Resend — document email (Sprint 3.5C). Required only to email generated
# documents; validated lazily so the rest of the app runs without them.
# Get the key from: Resend dashboard → API Keys. NEVER commit a real key.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Verified sender address (must belong to a domain verified in Resend).
# Bare email ONLY — the display name goes in RESEND_FROM_NAME, not here.
RESEND_FROM_EMAIL="documents@yourdomain.com"
# Optional sender display name shown to recipients (e.g. "PrepProfit <documents@...>").
# Defaults to "PrepProfit" when unset.
# RESEND_FROM_NAME="PrepProfit"
# Optional reply-to address; set on outbound mail when present.
# RESEND_REPLY_TO="hello@yourdomain.com"

# Gemini — AI photo recipe extraction (Sprint 4.7). Required only to run photo
# extraction (a Pro/Business feature); validated lazily (aiEnv() in lib/env.ts) so
# the rest of the app runs without it. A secret — NEVER commit it; it is never
# logged. Get the key from: Google AI Studio → API keys.
GEMINI_API_KEY="AIza-xxxxxxxxxxxxxxxxxxxx"

# Sentry — error monitoring (Sprint 5a). All optional: with no DSN, Sentry is a
# no-op (fail-open) and the app logs to console exactly as before. Get the DSN from:
# Sentry dashboard → your project → Settings → Client Keys (DSN).
# SENTRY_DSN="https://xxxx@oyyyy.ingest.sentry.io/zzzz"
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@oyyyy.ingest.sentry.io/zzzz"
# Build/CI only — uploads source maps for readable stack traces. A secret; never
# commit it. Without it the build still succeeds (no source maps uploaded).
# SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxx"
# SENTRY_ORG="your-sentry-org-slug"
# SENTRY_PROJECT="prepprofit"

# PostHog — product analytics (Sprint 5c). Optional: with no key, analytics is a
# no-op (fail-open). Only a PII-free allowlist of business events is captured.
# POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxxxxx"
# POSTHOG_HOST="https://us.i.posthog.com"  # or https://eu.i.posthog.com

# Comped orgs — operator/internal organization ids that get the Business tier
# (all features) regardless of Clerk billing. Comma-separated; empty by default so
# customer billing is untouched. Use it to grant your own org full access without a
# paid subscription. NOT a role bypass — only these exact org ids are affected.
# COMPED_ORG_IDS="org_xxxxxxxxxxxxxxxxxxxx"

# Flows — in-app onboarding / product adoption (tours, checklists, hints, surveys).
# Optional: with no organization id the FlowsProvider is skipped and the app renders
# untouched. Find the id in your Flows dashboard → Settings → General.
# NEXT_PUBLIC_FLOWS_ORGANIZATION_ID="your-flows-organization-id"
# Flows environment key (Settings → Environments). Defaults to "production".
# NEXT_PUBLIC_FLOWS_ENVIRONMENT="production"

# Crisp — human live-chat support widget. PUBLIC (embedded in the client bundle),
# loaded ONLY inside the authenticated app (never on marketing routes). Optional: with
# no id the widget is a no-op and never appears. Get it from: Crisp dashboard →
# Settings → Website Settings → Setup instructions (the WEBSITE_ID uuid).
# NEXT_PUBLIC_CRISP_WEBSITE_ID="00000000-0000-0000-0000-000000000000"
