# ──────────────────────────────────────────────────────────────
# PrepProfit — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit secrets.
# See SETUP.md for step-by-step instructions to obtain these.
# ──────────────────────────────────────────────────────────────

# Neon Postgres — connection string (use the POOLED connection string)
# Get it from: Neon dashboard → your project → Connection Details
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# Clerk — auth + Organizations
# Get these from: Clerk dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# Clerk — reserved system user that holds the org delete permission (Sprint 4e
# org self-delete lockdown). Optional: when unset, the lockdown no-ops, so the app
# runs fine without it. Set it to the `user_...` id of the internal "system" user
# created per Clerk instance; the lockdown reserves it as each org's `org:admin`
# and demotes the customer to the delete-less `org:owner` role. See SETUP.md.
# CLERK_SYSTEM_USER_ID="user_xxxxxxxxxxxxxxxxxxxx"

# Clerk — routing (defaults match the app's route structure)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Cron — shared secret protecting the trash auto-purge route
# (/api/cron/purge-trash). Vercel sends it automatically as a Bearer token to
# scheduled invocations once set in the project's Environment Variables.
# Generate a long random value, e.g.: openssl rand -hex 32
CRON_SECRET="generate-a-long-random-string"

# Resend — document email (Sprint 3.5C). Required only to email generated
# documents; validated lazily so the rest of the app runs without them.
# Get the key from: Resend dashboard → API Keys. NEVER commit a real key.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Verified sender address (must belong to a domain verified in Resend).
# Bare email ONLY — the display name goes in RESEND_FROM_NAME, not here.
RESEND_FROM_EMAIL="documents@yourdomain.com"
# Optional sender display name shown to recipients (e.g. "PrepProfit <documents@...>").
# Defaults to "PrepProfit" when unset.
# RESEND_FROM_NAME="PrepProfit"
# Optional reply-to address; set on outbound mail when present.
# RESEND_REPLY_TO="hello@yourdomain.com"
